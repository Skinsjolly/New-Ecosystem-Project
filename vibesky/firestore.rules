rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Users: any profile is public to read (signup needs to check handle availability
    // before the user is signed in); only the owner may update/create their own.
    // On update, the permanent username (handle) must stay unchanged.
    match /users/{uid} {
      allow read: if true;
      allow create: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn() && request.auth.uid == uid && (
        // Normal edits: permanent username must stay unchanged
        (request.resource.data.handle == resource.data.handle
          && request.resource.data.handleLower == resource.data.handleLower)
        ||
        // One-time claim: legacy accounts set their username for the first time
        (!(resource.data.usernameSet == true) && request.resource.data.usernameSet == true)
      );
      allow delete: if false;

      // Notifications inbox: only the owner can read/update (mark read).
      match /notifications/{nid} {
        allow read, update, delete: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn();
      }

      // Following / followers relations: eval by the acting user.
      match /following/{target} {
        allow read: if signedIn();
        allow create, delete: if signedIn() && request.auth.uid == uid;
      }
      match /followers/{follower} {
        allow read: if signedIn();
        allow create, delete: if signedIn() && request.auth.uid == follower;
      }

      // Per-user conversation summaries: owner only.
      match /conversations/{cid} {
        allow read, update: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn() && request.auth.uid == uid;
        allow delete: if false;
      }
    }

    // Posts: anyone signed in can read all posts, any signed-in user can create.
    // Only the author can delete their own post.
    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if signedIn() && resource.data.authorId == request.auth.uid;

      // Likes / reposts (acting user only)
      match /likes/{uid} {
        allow read: if signedIn();
        allow create, delete: if signedIn() && request.auth.uid == uid;
      }
      match /reposts/{uid} {
        allow read: if signedIn();
        allow create, delete: if signedIn() && request.auth.uid == uid;
      }

      // Comments: any signed-in user can add
      match /comments/{cid} {
        allow read: if signedIn();
        allow create: if signedIn() && request.auth.uid == request.resource.data.authorId;
        allow delete: if signedIn() && resource.data.authorId == request.auth.uid;
      }

      // Reactions: acting user only (emoji, last one wins)
      match /reactions/{uid} {
        allow read: if signedIn();
        allow create, update, delete: if signedIn() && request.auth.uid == uid;
      }
    }

    // Sky: 24h ephemeral posts
    match /skies/{skyId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if false;
      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;
    }

    // Private conversations between two users
    match /conversations/{convId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn() && request.auth.uid in request.resource.data.participants;
      allow update: if signedIn() && request.auth.uid in resource.data.participants;
      allow delete: if false;

      match /messages/{mid} {
        allow read: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants;
        allow create: if signedIn() && request.auth.uid == request.resource.data.senderId
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants;
        allow update, delete: if false;
      }
    }
  }
}